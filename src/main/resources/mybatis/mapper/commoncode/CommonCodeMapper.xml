<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  공통코드 조회 (FE 드롭다운용). COMMON_CODE × COMMON_CODE_GROUP
  ⚠️ 활성 상태값 'ACT' 가정 (COMMON_CODE.VAL_STATUS 기본값). 실제 활성코드가 다르면 교정.
-->
<mapper namespace="com.univus.app.commoncode.mapper.CommonCodeMapper">

    <!-- 그룹코드(GRP_CODE)로 활성 공통코드 목록 조회, CODE_ORDER 정렬 -->
    <select id="selectCodesByGroupCode" resultType="com.univus.app.commoncode.dto.CommonCodeResponseDto">
        SELECT c.CODE_VAL   AS codeVal,
               c.CODE_NM    AS codeName,
               c.CODE_ORDER AS codeOrder
        FROM COMMON_CODE c
        JOIN COMMON_CODE_GROUP g ON g.GRP_CODE_ID = c.GRP_CODE_ID
        WHERE g.GRP_CODE = #{groupCode}
          AND c.VAL_STATUS = 'ACT'
        ORDER BY c.CODE_ORDER
    </select>

</mapper>
